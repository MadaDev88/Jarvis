# ---------------------------------------------------------------------------
# Solana trading bot configuration
# Copy to .env and adjust. Defaults shown here are the built-in defaults.
# ---------------------------------------------------------------------------

# "paper" (simulated, default) or "live" (real funds!)
MODE=paper

# Solana RPC endpoint. The public endpoint is heavily rate limited; use a
# provider (Helius, Triton, QuickNode, ...) for live trading.
RPC_URL=https://api.mainnet-beta.solana.com

# Jupiter API base URL. The lite tier needs no API key.
JUPITER_BASE_URL=https://lite-api.jup.ag

# Trading pair (mint addresses). Defaults: SOL / USDC.
BASE_MINT=So11111111111111111111111111111111111111112
QUOTE_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
BASE_SYMBOL=SOL
QUOTE_SYMBOL=USDC
BASE_DECIMALS=9
QUOTE_DECIMALS=6

# Strategy: "sma-cross" (trend following) or "rsi" (mean reversion)
STRATEGY=sma-cross
SMA_FAST=9
SMA_SLOW=21
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70

# How often to poll prices (seconds)
POLL_INTERVAL_SEC=30

# Risk controls (quote units, i.e. USDC by default)
TRADE_SIZE_QUOTE=25
MAX_POSITION_QUOTE=100
STOP_LOSS_PCT=5
TAKE_PROFIT_PCT=10
MAX_DAILY_LOSS_QUOTE=50
SLIPPAGE_BPS=50

# Paper mode starting balance (quote units)
PAPER_STARTING_QUOTE=1000

# --- Live mode only -------------------------------------------------------
# NEVER commit a private key. Use a dedicated hot wallet funded with only
# what you are prepared to lose. Base58 string or JSON byte array.
# SOLANA_PRIVATE_KEY=
# Required safety interlock for live mode:
# LIVE_TRADING_ACKNOWLEDGED=I_UNDERSTAND_THE_RISKS
